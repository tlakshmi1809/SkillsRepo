{
  "mcpServers": {
    "rest-api-server": {
      "command": "/config/Desktop/Session1/mcp-rest-server/.venv/bin/python3",
      "args": [
        "/config/Desktop/Session1/mcp-rest-server/server.py"
      ],
      "env": {
        "API_BASE_URL": "https://httpbin.org",
        "API_USER_TOKEN": "your_user_token_or_api_key_here",
        "AUTH_SCHEME": "Bearer",
        "AUTH_HEADER_NAME": "Authorization",
        "LOG_LEVEL": "INFO"
      }
    },
    "rest-api-server-docker": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--env-file",
        "/config/Desktop/Session1/mcp-rest-server/.env",
        "mcp-rest-server:latest"
      ]
    }
  }
}

# Target HTTPS REST API Base URL
API_BASE_URL=https://api.yourdomain.com/v1

# Authentication User Token / API Key
API_USER_TOKEN=your_secret_api_token_here

# Authentication Scheme: Bearer, Basic, Header, or Query
AUTH_SCHEME=Bearer

# Header name when AUTH_SCHEME is Header or Bearer or Basic
AUTH_HEADER_NAME=Authorization

# Query parameter name when AUTH_SCHEME is Query
AUTH_QUERY_PARAM_NAME=api_key

# HTTP request timeout in seconds
HTTP_TIMEOUT=30.0

# Max response character limit before truncation
MAX_RESPONSE_CHAR_LIMIT=10000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
